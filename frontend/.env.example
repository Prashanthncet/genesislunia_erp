# ── Genesis ERP frontend environment ────────────────────────────
# Copy to `.env.local`. `.env*.local` is gitignored.

# Base URL of the NestJS backend.
#
# In LOCAL DEVELOPMENT next.config.mjs rewrites `/api/*` here, so the browser only
# ever talks to this origin (no CORS in the happy path).
BACKEND_URL="http://localhost:3001"

# Public base URL of this app. Used for absolute links (e.g. the parent-facing
# admission form link) when a real origin is needed instead of a relative path.
# Production value: https://genesislumia-erp-demo.vercel.app
FRONTEND_URL="http://localhost:5173"

# Base URL of the NestJS backend. In local development next.config.mjs rewrites
# `/api/*` here, so the browser only ever talks to this origin (no CORS in the
# happy path).
BACKEND_URL="http://localhost:3001"

# Production does NOT read BACKEND_URL from here: the deployed Vercel app reads
# it from the Vercel project environment variables (Dashboard → genesislumia-erp-demo
# → Settings → Environment Variables → BACKEND_URL).
# Production value: BACKEND_URL = https://genesislumia-erp-demo.onrender.com

# Shared secret between Next.js BFF Route Handlers and the NestJS backend
# for server-to-server proxy verification.
BFF_SHARED_SECRET="genesis-bff-internal-s2s"
