# ── Genesis ERP frontend environment ────────────────────────────
# Copy to `.env.local`. `.env*.local` is gitignored.

# Base URL of the NestJS backend.
#
# In LOCAL DEVELOPMENT next.config.mjs rewrites `/api/*` here, so the browser only
# ever talks to this origin (no CORS in the happy path).
BACKEND_URL="http://localhost:3001"

# DEPLOYED WORKER: this variable is NOT what production uses.
# `cf-worker.mjs` intercepts `/api/*` before Next.js and proxies to the value of
# Workers KV (binding CONFIG, key BACKEND_URL), read per request. That means the
# live API host can change without a rebuild:
#
#   npx wrangler kv key put --binding CONFIG "BACKEND_URL" "https://genesis-erp-api.onrender.com" --remote
#
# Setting BACKEND_URL at build time still matters for two things only: the
# OpenNext-rendered rewrites manifest, and as a fallback if the KV key is missing
# (missing key = a clean 503 JSON, never a localhost request).

# Public base URL of this app. Used for absolute links (e.g. the parent-facing
# admission form link) when a real origin is needed instead of a relative path.
FRONTEND_URL="http://localhost:5173"
