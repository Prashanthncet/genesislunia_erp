# ── Genesis ERP backend environment ─────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# SQLite connection string. Prisma also reads this.
DATABASE_URL="file:./dev.db"

# Which Prisma schema/clients the app and its Docker image build against.
# Unset = SQLite (prisma/schema.prisma). `postgresql` = prisma/postgres/schema.prisma,
# which is what production uses. With Postgres, use the DIRECT host (no `-pooler`)
# for migrations: a pooled URL breaks prepared statements mid-migration.
# PRISMA_SCHEMA="postgresql"

# REQUIRED in production. Signs every JWT. Anyone holding it can mint valid
# tokens, so generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a built-in fallback is used with a loud warning.
JWT_SECRET=""

# Token lifetime (ms-style string accepted by `ms`).
JWT_EXPIRES_IN="8h"

# HTTP port.
PORT=3001

# Absolute URL of the Next.js frontend. Used to build the parent-facing
# admission form links that get emailed/SMS'd out.
# Production value: https://genesislumia-erp-demo.vercel.app
FRONTEND_URL="http://localhost:5173"

# Comma-separated list of browser origins allowed to call the API.
# REQUIRED in production — the server refuses to boot without it.
# Production value: https://genesislumia-erp-demo.vercel.app
#   CORS_ORIGINS="https://erp.your-school.edu,https://www.your-school.edu"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Outbound notification delivery. Leave unset in development: the notification
# service then records messages with an honest `mocked` status instead of
# pretending to send them.
# NOTIFY_WEBHOOK_URL="https://your-provider.example/send"

# "production" enables the strict fail-fast paths for JWT_SECRET and CORS_ORIGINS.
NODE_ENV="development"
# HMAC secret for the notification webhook above. REQUIRED when NOTIFY_WEBHOOK_URL
# is set — without it messages are not sent (logged as `failed`), never unsigned.
# NOTIFY_WEBHOOK_SECRET=""

# ── Online payments (Razorpay). Unset = "mock" gateway (dev only; refused in production).
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# RAZORPAY_WEBHOOK_SECRET=""
# Default admission fee when an application has none set.
# ADMISSION_FEE_AMOUNT=25000

# Login attempts per minute per IP (default 10).
# LOGIN_RATE_LIMIT=10

# API docs at /api/docs are OFF in production unless explicitly enabled.
# SWAGGER_ENABLED=1

# Report aggregate cache lifetime in ms (Redis when REDIS_URL is set, else in-process). 0 disables.
# REPORT_CACHE_TTL_MS=60000

# Shown in /api/health.
# APP_VERSION="1.0.0"

# Requests/min per client IP (default 300). Behind a reverse proxy ALSO set TRUST_PROXY.
# GLOBAL_RATE_LIMIT=300
# Number of proxy hops in front of the API (e.g. 1 for nginx). Without it, every user
# shares the proxy IP and therefore one rate-limit bucket.
# TRUST_PROXY=1

# ── Redis (optional). Set it when running MORE THAN ONE API instance: report cache is
# shared (per-school invalidation via a version key), rate limits are counted across
# instances, and 5xx alert de-dup is shared. Unset = in-process behaviour.
# /api/health reports "redis": "ok" | "down" (503) when configured.
# REDIS_URL="redis://localhost:6379"

# ── Notification delivery drivers, chosen PER CHANNEL (see src/notifications/providers.ts).
# A channel with no driver logs messages as "mocked"; in production a warning per such
# channel is logged at boot. Failed sends are retried 1m, 5m, 30m, 2h (5 attempts total)
# by the per-minute retry job; messages containing OTPs/passwords are never retried.
# Email via SMTP (nodemailer). SMTP_SECURE=true for implicit TLS (port 465); otherwise
# STARTTLS is used when the server offers it.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Genesis ERP <no-reply@your-school.edu>"
# SMS via MSG91 Flow API (DLT template). The message body is passed as ONE template
# variable named MSG91_BODY_VAR (default "message", i.e. template text "##message##").
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# MSG91_SENDER_ID=""
# MSG91_BODY_VAR="message"
# SMS / WhatsApp via Twilio. TWILIO_FROM = SMS sender number; TWILIO_WHATSAPP_FROM =
# WhatsApp-enabled sender (e.g. +14155238886 for the sandbox).
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# TWILIO_WHATSAPP_FROM=""
# WhatsApp via the Meta WhatsApp Cloud API (official, and the preferred driver when
# both are configured). WHATSAPP_TOKEN = permanent system-user token;
# WHATSAPP_PHONE_NUMBER_ID = the sender number's ID in Meta Business. Free-form text
# only sends inside the 24-hour customer-service window; business-initiated messages
# need an approved template, which the driver does not send.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# Free/un-official WhatsApp: a self-hosted WhatsApp Web gateway that speaks the
# WPPConnect REST shape (WPPConnect Server, Baileys/wwebjs wrappers). Messages go out
# from a WhatsApp account linked by QR code, not a business number, so WhatsApp may
# rate-limit or ban that account — use a dedicated school number.
# WHATSAPP_GATEWAY_URL="http://localhost:21465"
# WHATSAPP_GATEWAY_SESSION="genesis"
# WHATSAPP_GATEWAY_TOKEN=""
# Free SMS through an Android phone and its own SIM (textbee.dev, MIT):
# TEXTBEE_API_KEY=""
# TEXTBEE_DEVICE_ID=""
# TEXTBEE_API_BASE="https://api.textbee.dev"
# Force the WhatsApp driver when several are configured: cloud | wppconnect | twilio | webhook.
# WHATSAPP_PROVIDER=""
# Force the SMS driver when several are configured: msg91 | twilio | textbee | vonage | webhook.
# SMS_PROVIDER=""
# SMS / WhatsApp via Vonage Messages API (v1). Uses Basic auth (api_key:api_secret) on
# https://api.nexmo.com/v1.messages. For WhatsApp the same Messages API is used; that
# needs a WhatsApp-enabled Vonage number + WABA, and business-initiated messages still
# need an approved template on Vonage's side.
# VONAGE_API_KEY=""
# VONAGE_API_SECRET=""
# VONAGE_NUMBER=""        # sender number (SMS) or WhatsApp-enabled number (WhatsApp)
# VONAGE_API_BASE="https://api.nexmo.com"
# Force the WhatsApp driver when several are configured: cloud | wppconnect | twilio | vonage | webhook.
# WHATSAPP_PROVIDER=""
# Country code prepended to 10-digit numbers (default 91).
# SMS_DEFAULT_COUNTRY_CODE=91
# Provider HTTP timeout (ms, default 10000).
# NOTIFY_TIMEOUT_MS=10000
# Test/stub overrides of the provider API base URLs (leave unset in production).
# TWILIO_API_BASE="https://api.twilio.com"
# MSG91_API_BASE="https://control.msg91.com"
# WHATSAPP_API_BASE="https://graph.facebook.com"
# WHATSAPP_API_VERSION="v21.0"
# Recipients for the manual driver check `node scripts/test-notifications.js`
# (comma separated; numbers may be 10-digit Indian or E.164).
# NOTIFY_TEST_EMAIL=""
# NOTIFY_TEST_NUMBERS=""

# School timezone for daily jobs (admission reminders run 09:00 here; run-lock key = date here).
# TZ_SCHOOL="Asia/Kolkata"

# ── Error alerting. 5xx responses (and frontend crashes posted to
# /api/telemetry/client-error) go to Sentry when SENTRY_DSN is set — auth headers,
# cookies, query strings and request bodies are stripped — and to ALERT_WEBHOOK_URL as
# a JSON POST, at most once per error signature per ALERT_DEDUP_MS (default 5 min).
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"
# SENTRY_RELEASE="1.0.0"
# SENTRY_TRACES_SAMPLE_RATE=0
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
# ALERT_DEDUP_MS=300000
# Client error reports accepted per minute per IP (default 20).
# CLIENT_ERROR_RATE_LIMIT=20

# ── Document storage. "s3" works for AWS S3, Cloudflare R2 (set S3_ENDPOINT) and MinIO.
# "local" keeps files on this server's disk — production refuses it unless STORAGE_ALLOW_LOCAL=1
# (no sharing between instances, no off-site copy). Neon object storage works through the same
# s3 driver and needs S3_FORCE_PATH_STYLE=1: S3_ENDPOINT=https://<branch>.storage.<cell>.aws.neon.tech
# STORAGE_DRIVER=local
# STORAGE_DIR=./storage
# STORAGE_ALLOW_LOCAL=1
# STORAGE_SIGNING_SECRET=""        # signs local download URLs (defaults to JWT_SECRET)
# STORAGE_URL_TTL_SECONDS=300
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION=auto
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=1            # MinIO / some S3-compatibles / Neon object storage
# Move legacy in-database documents to storage once: node scripts/migrate-documents-to-storage.js

# ── Off-site backups (scripts/backup-db.js uploads each verified snapshot here).
# BACKUP_S3_BUCKET=""
# BACKUP_KEEP_REMOTE=30
